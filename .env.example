# AFARI environment configuration
# Copy to .env.local and fill in values for your environment.

# --- Core ---
NEXT_PUBLIC_APP_NAME=AFARI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Phase 1+) ---
DATABASE_URL=postgres://afari:afari@localhost:5432/afari

# --- Auth ---
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- File storage ---
S3_BUCKET=afari-receipts
S3_REGION=af-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Third-party (Phase 2+) ---
DUFFEL_API_TOKEN=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Payments ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Notifications ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- AI ---
ANTHROPIC_API_KEY=
